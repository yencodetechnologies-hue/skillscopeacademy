# Copy to .env and fill in values for local development
PORT=8000
MONGO_URI=your_mongodb_connection_string

# eWAY (required for card payments)
EWAY_ENVIRONMENT=Sandbox
EWAY_API_KEY=your_eway_api_key
EWAY_API_PASSWORD=your_eway_api_password

# Optional: extra CORS origins (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# Google Places — daily review sync (server-side only)
GOOGLE_PLACES_API_KEY=AIzaSyAz0MGks9dq9vX_0Do7jSVCJuEuKu8Dy_c
GOOGLE_PLACE_ID=ChIJR90q3fW9EmsRh9preTZ4ZE0
# Cron: 1:XX AM Australia/Sydney (minute 1–59, default 30 = 1:30 AM)
GOOGLE_REVIEWS_CRON_MINUTE=30
GOOGLE_REVIEWS_CRON_ENABLED=true
# Optional overrides
# REVIEWS_CRON_SCHEDULE=30 1 * * *
# REVIEWS_CRON_TIMEZONE=Australia/Sydney
